# Start an interactive CHTC build job with:
#   condor_submit -i gctffind-build.sub
# Then build with:
#   apptainer build gctffind.sif gctffind.def

universe = vanilla
log = gctffind-build.log

transfer_input_files = gctffind.def, gctffind-build.patch, gctffind_cuda_probe.cu

+IsBuildJob = True
request_cpus = 8
request_memory = 24GB
request_disk = 50GB

queue
