# High-memory GPU test. Requires the updated run_pytom_match.sh.
universe = vanilla
executable = run_pytom_match.sh
ROOT = /staging/h/hzhan3/pytom_match_pick_test
TOMOGRAM = $(ROOT)/TS_$(ts).st_12.00Apx.mrc
WARP_XML = $(ROOT)/TS_$(ts).st.xml
TEMPLATE = $(ROOT)/templates/80S_12.00Apx.mrc
MASK = $(ROOT)/templates/80S_mask.mrc
# Unique output protects the existing matching run's results.
OUTPUT_ARCHIVE = $(ROOT)/output_picker_80S_40gb_TS_$(ts)_$(Cluster)_$(Process).tar.gz
PARTICLE_DIAMETER = 300
MAX_PARTICLES = 5000
# 40 GB does not guarantee that the whole unsplit volume fits.
VOLUME_SPLIT_X = 2
VOLUME_SPLIT_Y = 2
VOLUME_SPLIT_Z = 2
LOW_PASS = 40
# Use 0 to compare against the old A100 command (which omitted correction).
RANDOM_PHASE_CORRECTION = 1
environment = "PYTOM_LOW_PASS=$(LOW_PASS) PYTOM_RANDOM_PHASE_CORRECTION=$(RANDOM_PHASE_CORRECTION)"
arguments = $(TOMOGRAM) $(TEMPLATE) $(MASK) $(WARP_XML) $(OUTPUT_ARCHIVE) TS_$(ts) $(PARTICLE_DIAMETER) $(MAX_PARTICLES) $(VOLUME_SPLIT_X) $(VOLUME_SPLIT_Y) $(VOLUME_SPLIT_Z)
log = logs/pytom_match_40gb_TS_$(ts)_$(Cluster)_$(Process).log
output = logs/pytom_match_40gb_TS_$(ts)_$(Cluster)_$(Process).out
error = logs/pytom_match_40gb_TS_$(ts)_$(Cluster)_$(Process).err
container_image = osdf:///chtc/staging/hzhan3/pytom-match-pick.sif
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_output_files = ""
requirements = (HasCHTCStaging == true)
+WantGPULab = true
+GPUJobLength = "long"
request_gpus = 1
gpus_minimum_memory = 40000M
gpus_minimum_capability = 8.0
# Allows A100 and other qualifying GPUs, not exclusively A100.
request_cpus = 4
request_memory = 64GB
request_disk = 80GB
# Benchmark one tomogram before expanding the batch.
queue ts in 1
