# Example only: replace USERNAME and the WarpTools command/paths.
universe = vanilla
executable = run_warp.sh
arguments = WarpTools --help

log = logs/warp_$(Cluster)_$(Process).log
error = logs/warp_$(Cluster)_$(Process).err
output = logs/warp_$(Cluster)_$(Process).out

container_image = osdf:///chtc/staging/USERNAME/warp-miss-alignment.sif
should_transfer_files = YES
when_to_transfer_output = ON_EXIT

requirements = (HasCHTCStaging == true)
+WantGPULab = true
+GPUJobLength = "short"

request_gpus = 1
request_cpus = 4
request_memory = 16GB
request_disk = 30GB

queue 1
