# Single-series archive-mode example for TS_2.

universe = vanilla
executable = run_warp_pipeline_archive.sh
transfer_input_files = run_warp_pipeline.sh

project_root = /staging/hzhan3/warp-miss-alignment-test/2810_g1
project_archive = $(project_root)/output_TS_2_run001.tar.gz
arguments = $(project_archive) output_TS_2_run001 TS_2

log = logs/warp_archive_TS_2_$(Cluster)_$(Process).log
error = logs/warp_archive_TS_2_$(Cluster)_$(Process).err
output = logs/warp_archive_TS_2_$(Cluster)_$(Process).out

container_image = osdf:///chtc/staging/hzhan3/warp-miss-alignment.sif
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_output_files = ""

requirements = (HasCHTCStaging == true)
+WantGPULab = true
+GPUJobLength = "medium"

request_gpus = 1
request_cpus = 4
request_memory = 32GB
request_disk = 100GB

queue 1
