# GPU smoke test for the separate AreTomo3 image.

universe = vanilla
executable = run_aretomo3_smoke_test.sh

log = logs/aretomo3_smoke_$(Cluster)_$(Process).log
error = logs/aretomo3_smoke_$(Cluster)_$(Process).err
output = logs/aretomo3_smoke_$(Cluster)_$(Process).out

container_image = osdf:///chtc/staging/hzhan3/aretomo3.sif
should_transfer_files = YES
when_to_transfer_output = ON_EXIT

requirements = (HasCHTCStaging == true)
+WantGPULab = true
+GPUJobLength = "short"

request_gpus = 1
gpus_minimum_capability = 7.0
gpus_minimum_memory = 10000M
request_cpus = 2
request_memory = 8GB
request_disk = 10GB

queue 1
