# PyTom Match Pick example for the final MissAlignment TS_2 reconstruction.
# Replace TEMPLATE and MASK, and set PARTICLE_DIAMETER for your target.

TOMOGRAM = /staging/hzhan3/warp-miss-alignment-test/2810_g1/output_TS_2_run001/warp_tiltseries/iter8/reconstruction/TS_2.st_12.00Apx.mrc
WARP_XML = /staging/hzhan3/warp-miss-alignment-test/2810_g1/output_TS_2_run001/warp_tiltseries/iter8/TS_2.st.xml
TEMPLATE = /staging/hzhan3/CHANGE_ME/template.mrc
MASK = /staging/hzhan3/CHANGE_ME/mask.mrc
DESTINATION = /staging/hzhan3/warp-miss-alignment-test/2810_g1/output_TS_2_run001/pytom_match_pick/iter8
PARTICLE_DIAMETER = 300

universe = vanilla
executable = run_pytom_match.sh
arguments = $(TOMOGRAM) $(TEMPLATE) $(MASK) $(DESTINATION) $(PARTICLE_DIAMETER) $(WARP_XML)

log = logs/pytom_match_$(Cluster)_$(Process).log
error = logs/pytom_match_$(Cluster)_$(Process).err
output = logs/pytom_match_$(Cluster)_$(Process).out

container_image = osdf:///chtc/staging/hzhan3/pytom-match-pick.sif
should_transfer_files = YES
when_to_transfer_output = ON_EXIT

requirements = (HasCHTCStaging == true)
+WantGPULab = true
+GPUJobLength = "long"

request_gpus = 1
gpus_minimum_memory = 10000M
request_cpus = 4
request_memory = 32GB
request_disk = 40GB

queue 1
