# Single-GPU (>=40 GB VRAM) MissAlignment example.
# Replace USERNAME and PROJECT below. The YAML should use /staging paths for
# both its input and output so progress survives eviction or a time limit.

universe = vanilla
executable = run_miss_alignment.sh
arguments = /staging/hzhan3/warp-miss-alignment-test/2810_g1/output_TS_2_run001/config.yml 0

log = logs/miss_alignment_$(Cluster)_$(Process).log
error = logs/miss_alignment_$(Cluster)_$(Process).err
output = logs/miss_alignment_$(Cluster)_$(Process).out

container_image = osdf:///chtc/staging/hzhan3/warp-miss-alignment.sif
should_transfer_files = YES
when_to_transfer_output = ON_EXIT

requirements = (HasCHTCStaging == true)
+WantGPULab = true
+GPUJobLength = "long"

request_gpus = 1
gpus_minimum_memory = 40000M
request_cpus = 8
request_memory = 64GB
request_disk = 50GB

queue 1
