# WarpTools test pipeline for TS_2 on CHTC.
# The input and all generated results remain under /staging.

universe = vanilla
executable = run_warp_pipeline.sh
arguments = /staging/hzhan3/warp-miss-alignment-test/2810_g1/output_TS_2_run001

log = logs/warp_pipeline_$(Cluster)_$(Process).log
error = logs/warp_pipeline_$(Cluster)_$(Process).err
output = logs/warp_pipeline_$(Cluster)_$(Process).out

container_image = osdf:///chtc/staging/hzhan3/warp-miss-alignment.sif
should_transfer_files = YES
when_to_transfer_output = ON_EXIT

requirements = (HasCHTCStaging == true)
+WantGPULab = true
+GPUJobLength = "medium"

request_gpus = 1
request_cpus = 4
request_memory = 32GB
request_disk = 40GB

queue 1

